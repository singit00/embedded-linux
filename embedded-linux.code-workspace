{
    "folders": [
        {
            "path": "."
        }
    ],

    "settings": {
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.cStandard": "c11",

        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,

        "files.exclude": {
            "**/.git": true
        },

        "cmake.buildDirectory": "${workspaceFolder}/build"
    },

    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "twxs.cmake"
        ]
    }
}